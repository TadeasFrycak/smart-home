        "dropdown_menu":  "<div class='dropDownModule modalModule'><div class='input-field col s12'><select><option value='' disabled selected>::label::</option><option value='1'>RED</option><option value='2'>GREEN</option><option value='3'>BLUE</option></select><label>::LABEL::</label></div></div>",
        "progress_bar": "<div class='progress'><div class='progress-bar progress-bar-striped bg-::color::' role='progressbar' style='width: ::value::%' aria-valuenow='::value::' aria-valuemin='0' aria-valuemax='100'>::label::</div></div>",
        "button": "<button type='button' class='btn btn-::color::' style='margin-bottom:15px;width100%'>::label::</button><br>",
        "graph-picker": "<div class='btn-group btn-group-toggle' data-id='::id::' data-toggle='buttons'><label class='btn btn-secondary active'><input type='radio' name='options' id='option1' autocomplete='off' checked> Last Week</label><label class='btn btn-secondary'><input type='radio' name='options' id='option2' autocomplete='off'> Last day</label><label class='btn btn-secondary'><input type='radio' name='options' id='option3' autocomplete='off'> All</label></div>",
        "graph": "<div class='apex-graph' id='::id::' data-id='::id::'></div><div id='::id::_brush'></div>",
