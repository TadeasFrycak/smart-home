    "items": {
        "toggle": "<div class='tile' data-id='::id::'><div class='tileTextLayer'><img src='::img_src::' class='tileImage'><span class='tileDescription'>::label::</span><span class='tileStatus'>OFF</span></div><div class='titeAtributes'>test</div><div class='tileTouchLayer tileToggle tileModal'></div></div>",    
        "percentage": "<div class='tile' data-id='::id::'><div class='tileTextLayer'><div class='tileInputVal'>::percentage::<span style='font-size: 15px;'> ::suffix::</span></div><span class='tileDescription'>::label::</span><span class='tileStatus'>1hr ago</span></div><div class='tileTouchLayer tileModal'></div></div>"
