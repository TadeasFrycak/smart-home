        "percentage": "<div class='tile' data-id='::id::' data-type='percentage'><div class='tileTextLayer'><div class='tileDisplay'><div class='tileInputVal'>::percentage::</div><span style='font-size: 15px;'>  ::suffix::</span></div><span class='tileDescription'>::label::</span><span class='tileStatus'>1hr ago</span></div><div class='tileTouchLayer tileModal'></div></div>",
        "gauge": "<div class='tile_gauge' data-min_val='::min_val::' data-max_val='::max_val::' data-suffix='::suffix::' data-color='::color::' data-target_id='::id::' data-target_value='::value::'><div class='tile_gauge_header'>::label::</div><div class='gauge-holder'><div id='::id::'></div></div></div>",
        "gauge_apex": "<div class='tile_chart' id='chart'></div>",
