        "separator": "<hr>",
        "toggle": "<div class='buttonModule' data-id='::id::'><div class='toggle-slider-div'>::label::<label class='switch'><input type='checkbox'><span class='toggle-slider round'></span></label></div></div>",
        "graph": "<div class='graphModul modalModule' data-header='::label::'><canvas></canvas></div>",
